rules_version = '2';

// Classements des épreuves (#14, décisions « Points et classement »,
// « Classements » et « Sans faute et Minute »,
// docs/etudes/2026-11-04-points-classement.md § 4).
// Sans serveur (offre Spark) : c'est l'appli qui écrit son score ; ces règles
// n'en vérifient que la vraisemblance (bornes du barème, taille de l'épreuve,
// semaine en cours, record qui progresse). Une place par pseudo (décision du
// même nom) : le document porte le nom du pseudo en minuscules, et tout
// compte qui joue sous ce pseudo peut l'améliorer. Tests :
// tests/regles.test.ts, sur l'émulateur. Tout le reste de la base est fermé.
service cloud.firestore {
  match /databases/{database}/documents {

    // Nombre de lieux de chaque série (src/vues/cibles.ts : 195 pays
    // jouables, répartis en six continents ; les 24 communes de La Réunion,
    // public/geo/reunion/communes.json).
    function tailles() {
      return {
        'Africa': 54,
        'Asia': 48,
        'Europe': 44,
        'North America': 23,
        'Oceania': 14,
        'South America': 12,
        'tous': 195,
        'reunion': 24
      };
    }

    // Une épreuve : « mode:localiser:série » (src/epreuve/chrono.ts, idEpreuve),
    // ou le général du Chrono.
    function epreuveConnue(p) {
      return p.size() == 3
        && p[0] in ['chrono', 'sansfaute', 'minute']
        && p[1] == 'localiser'
        && p[2] in tailles();
    }

    // Semaine du classement de la semaine : repart le lundi à 0 h UTC
    // (src/epreuve/bareme.ts, semaine()).
    function semaineCourante() {
      return 's' + string(int(math.floor((request.time.toMillis() - 345600000) / 604800000)));
    }

    // Chrono : toutes les questions de la série (n) ; 1 000 points par juste,
    // 500 au plus par erreur ; au moins 0,2 s par question, 15 s au plus. Le
    // général (n = 0) additionne les records du Chrono : 414 questions au plus
    // (195 pays deux fois, par continent et tous, + 24 communes).
    function chronoValide(d, n) {
      return d.questions >= 1 && (n == 0 ? d.questions <= 414 : d.questions == n)
        && d.points >= d.justes * 1000
        && d.points <= d.justes * 1000 + (d.questions - d.justes) * 500
        && d.temps_ms >= d.questions * 200 && d.temps_ms <= d.questions * 15000;
    }

    // Sans faute : les justes d'affilée (points = justes), plus l'erreur qui a
    // fini la partie, sauf la série vidée ; le temps des justes seules, de 0,2
    // à 15 s chacune.
    function sansFauteValide(d, n) {
      return d.points == d.justes
        && (d.questions == d.justes + 1 || (d.questions == d.justes && d.justes == n))
        && d.questions <= n
        && d.temps_ms >= d.justes * 200 && d.temps_ms <= d.justes * 15000;
    }

    // Minute : les justes (points = justes) en 60 s de réponse, au moins 0,2 s
    // par question ; moins de 60 s seulement si la série est vidée.
    function minuteValide(d, n) {
      return d.points == d.justes
        && d.questions <= n
        && d.temps_ms >= d.questions * 200 && d.temps_ms <= 60000
        && (d.temps_ms == 60000 || d.questions == n);
    }

    function scoreValide(epreuve) {
      let d = request.resource.data;
      let p = epreuve.split(':');
      return d.keys().hasOnly(['pseudo', 'points', 'justes', 'questions', 'temps_ms', 'date', 'bareme'])
        && d.keys().hasAll(['pseudo', 'points', 'justes', 'questions', 'temps_ms', 'date', 'bareme'])
        && d.pseudo is string && d.pseudo.size() >= 2 && d.pseudo.size() <= 20
        && d.points is int && d.justes is int && d.questions is int && d.temps_ms is int
        && d.bareme == 1
        && d.date == request.time
        && d.justes >= 0 && d.justes <= d.questions
        && (epreuve == 'general'
          ? chronoValide(d, 0)
          : epreuveConnue(p)
            && (p[0] == 'chrono' ? chronoValide(d, tailles()[p[2]])
              : p[0] == 'sansfaute' ? sansFauteValide(d, tailles()[p[2]])
              : minuteValide(d, tailles()[p[2]])));
    }

    // Un record ne se réécrit que s'il progresse (plus de points, puis moins de
    // temps, puis moins de questions : en Minute, moins d'erreurs), ou pour
    // changer de pseudo à score égal.
    function progresse() {
      let n = request.resource.data;
      let a = resource.data;
      return n.points > a.points
        || (n.points == a.points && n.temps_ms < a.temps_ms)
        || (n.points == a.points && n.temps_ms == a.temps_ms && n.questions < a.questions)
        || (n.points == a.points && n.temps_ms == a.temps_ms && n.justes == a.justes && n.questions == a.questions);
    }

    // La place d'un pseudo : son nom en minuscules (src/epreuve/chrono.ts,
    // clePseudo). Les règles n'en vérifient que la longueur : leur lower()
    // échoue sur une majuscule accentuée (« É », « Œ », « Ñ » : émulateur,
    // 06/11/2026). Cela suffit à refuser l'appli d'avant, qui nommait la place
    // par le compte (28 caractères, plus qu'un pseudo). Écrire demande un
    // compte (anonyme suffit). Personne ne la retire depuis l'appli : elle est
    // à tous ceux qui jouent ce pseudo.
    match /classements/{epreuve}/periodes/{periode}/scores/{cle} {
      allow read: if true;
      allow create: if request.auth != null
        && cle.size() == request.resource.data.pseudo.size()
        && (periode == 'toujours' || periode == semaineCourante())
        && scoreValide(epreuve);
      allow update: if request.auth != null
        && cle.size() == request.resource.data.pseudo.size()
        && (periode == 'toujours' || periode == semaineCourante())
        && scoreValide(epreuve) && progresse();
    }
  }
}
