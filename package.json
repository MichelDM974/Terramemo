{
  "name": "terramemo",
  "private": true,
  "version": "0.0.0",
  "description": "Devenir bon en géographie : répétition espacée sur une carte du monde (site + APK).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:regles": "firebase emulators:exec --only firestore --project demo-terramemo \"vitest run tests/regles.test.ts\"",
    "test:comptes": "firebase emulators:exec --only auth,firestore --project demo-terramemo \"vitest run --no-file-parallelism tests/comptes.test.ts tests/google.test.ts tests/profil.test.ts tests/envoi.test.ts tests/suppression.test.ts\"",
    "test:synchro": "firebase emulators:exec --only auth,firestore --project demo-terramemo \"vitest run tests/synchro-emulateurs.test.ts\"",
    "test:admin": "firebase emulators:exec --only auth,firestore --project demo-terramemo \"vitest run tests/admin.test.ts\"",
    "sim:charge": "SIM_CHARGE=1 vitest run --silent=false tests/sim-charge.test.ts",
    "admin": "node scripts/admin/outil.mjs",
    "geodata": "node geodata/build.mjs",
    "geodata:reunion": "node geodata/reunion.mjs",
    "wikidata": "node geodata/wikidata.mjs",
    "fiches": "node geodata/build.mjs --seulement fiches",
    "icone": "node geodata/icone.mjs",
    "vignette-ile": "node geodata/vignette-ile.mjs",
    "vignette-capitales": "node geodata/vignette-capitales.mjs",
    "vignette-mers": "node geodata/vignette-mers.mjs",
    "licences:android": "node licences/android.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capawesome/capacitor-google-sign-in": "0.1.4",
    "d3-geo": "3.1.2",
    "d3-selection": "3.0.1",
    "d3-transition": "3.0.2",
    "d3-zoom": "3.0.1",
    "earcut": "3.2.4",
    "firebase": "13.2.0",
    "topojson-client": "3.1.0",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@firebase/rules-unit-testing": "6.0.0",
    "@resvg/resvg-wasm": "2.6.2",
    "@types/d3-geo": "3.1.1",
    "@types/d3-selection": "3.0.12",
    "@types/d3-transition": "3.0.9",
    "@types/d3-zoom": "3.0.9",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.19.2",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "fake-indexeddb": "6.2.7",
    "firebase-admin": "14.5.0",
    "firebase-tools": "15.34.2",
    "mapshaper": "0.6.110",
    "polylabel": "2.1.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
