node_modules/
dist/
geodata/raw/
android/app/build/
android/.gradle/
*.log
.env*
.firebase/
coverage/
__pycache__/
firestore-debug.log

# Les WebP des photos des fiches (#34, D59) : hors de git, copiés sous
# ~/Sauvegardes/terramemo/photos/ par npm run photos:traiter, remis en place par
# npm run photos:restaurer ; seuls choix.json et licences.json sont versionnés.
public/photos/

# Clé de signature de l'APK : jamais dans le dépôt (décision « Signature de l'APK »)
*.jks
*.keystore
signature.properties

# Clé du compte de service de l'outil du propriétaire (scripts/admin/) : dans
# ~/Sauvegardes/terramemo/admin/, jamais dans le dépôt (décision
# « Confidentialité et ouverture des comptes »). Noms des clés de Google
# (projet-hash.json, *-firebase-adminsdk-*.json) et tout .json de scripts/admin/.
*firebase-adminsdk*.json
terramemo-geo-*.json
service-account*.json
scripts/admin/*.json
