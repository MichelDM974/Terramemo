rules_version = '2';

// Classements des épreuves (#14, décisions « Points et classement »,
// « Classements » et « Barème et classements » du 12/11/2026,
// docs/etudes/2026-11-04-points-classement.md § 4), puis profil et lots des
// comptes (J1b, docs/etudes/2026-11-07-j1b-conception.md § 6, en bas).
// Sans serveur (offre Spark) : c'est l'appli qui écrit son score ; ces règles
// n'en vérifient que la vraisemblance (barème 2 : points = justes, taille de l'épreuve,
// semaine en cours, record qui progresse). Une place par pseudo (décision du
// même nom) : le document porte le nom du pseudo en minuscules, et tout
// compte qui joue sous ce pseudo peut l'améliorer. Tests :
// tests/regles.test.ts, sur l'émulateur. Tout le reste de la base est fermé.
service cloud.firestore {
  match /databases/{database}/documents {

    // Nombre de questions de chaque série, par clé du sujet (src/epreuve/chrono.ts,
    // CLE_SUJET et EPREUVES_SUJETS ; étude J2 § 8.2). 'localiser', pays et
    // communes : les 195 pays jouables (src/vues/cibles.ts), répartis en six
    // continents, et les 24 communes de La Réunion
    // (public/geo/reunion/communes.json). 'capitales' : les séries et les
    // tailles des pays (D37 c : les 9 pays au nom de leur capitale restent en
    // épreuve), sans l'île. 'drapeaux' (lot 2) : de même, les séries et les
    // tailles des pays, sans l'île. 'mers' (lot 3b) : une série unique, les 5
    // océans et 45 mers et golfes (src/map/mers.ts, IDS_MERS ; D44 a).
    // 'silhouettes' (J4, lot 1) : les séries des pays sans les 29 micro-États
    // (D618 a : 166), acceptées avant que le site ne les ouvre
    // (SILHOUETTES_VISIBLES de src/visibles.ts). 'voisins' (J4, lot 2) : les
    // pays qui ont au moins un voisin jouable (156), sans série d'Océanie (une
    // seule question). Chaque carte s'écrit en entier, sans fusion.
    function tailles(cle) {
      return cle == 'mers'
        ? {
          'mers': 50
        }
        : cle == 'capitales'
        ? {
          'Africa': 54,
          'Asia': 48,
          'Europe': 44,
          'North America': 23,
          'Oceania': 14,
          'South America': 12,
          'tous': 195
        }
        : cle == 'drapeaux'
        ? {
          'Africa': 54,
          'Asia': 48,
          'Europe': 44,
          'North America': 23,
          'Oceania': 14,
          'South America': 12,
          'tous': 195
        }
        : cle == 'silhouettes'
        ? {
          'Africa': 49,
          'Asia': 45,
          'Europe': 38,
          'North America': 16,
          'Oceania': 6,
          'South America': 12,
          'tous': 166
        }
        : cle == 'voisins'
        ? {
          'Africa': 48,
          'Asia': 41,
          'Europe': 42,
          'North America': 12,
          'South America': 12,
          'tous': 156
        }
        : {
          'Africa': 54,
          'Asia': 48,
          'Europe': 44,
          'North America': 23,
          'Oceania': 14,
          'South America': 12,
          'tous': 195,
          'reunion': 24
        };
    }

    // Une épreuve : « mode:clé:série » (src/epreuve/chrono.ts, idEpreuve), la
    // clé d'un sujet qui a des épreuves, la série de ce sujet ; ou le général
    // du Chrono ; ou une difficulté du quiz général, « quiz:general:moyen »
    // (idQuiz, étude J2 § 9.4). Un sujet entre ici avant le site qui ouvre ses
    // épreuves (décision « Ouverture des épreuves d'un sujet », 12/11/2026 :
    // dès sa livraison, sans date de bascule ; le quiz, ses quatre sujets du
    // J2 livrés, D50 c). Minute est retiré (12/11/2026, décision « Barème et
    // classements ») : plus rien ne s'écrit sous « minute:… », id réservé,
    // jamais réutilisé (MODES_RETIRES).
    function epreuveConnue(p) {
      return p.size() == 3
        && ((p[0] in ['chrono', 'sansfaute']
          && p[1] in ['localiser', 'capitales', 'drapeaux', 'silhouettes', 'voisins', 'mers']
          && p[2] in tailles(p[1]))
        || (p[0] == 'quiz' && p[1] == 'general' && p[2] in tempsQuiz()));
    }

    // Le temps total le plus long d'une partie du quiz, par difficulté (ms) :
    // le délai de chacune de ses 20 questions (src/quiz/regles.ts,
    // tempsMaxQuiz de src/epreuve/chrono.ts) : 20 à 4 choix de 10 s en
    // facile ; 10 de 10 s et 10 au toucher de 15 s en moyen ; 8 et 12 en
    // difficile ; de même en expert, à 6 et 10 s.
    function tempsQuiz() {
      return {
        'facile': 200000,
        'moyen': 250000,
        'difficile': 260000,
        'expert': 168000
      };
    }

    // Le temps total le plus long d'un Chrono des Voisins, par série (ms) : la
    // somme des délais de ses questions, 4 s plus 2 s par voisin chacune
    // (décision « Barème et classements », exception du 28/11 ;
    // TEMPS_CHRONO_VOISINS_MS de src/epreuve/chrono.ts, que
    // tests/regles.test.ts confronte à ces règles). Toujours sous 15 s par
    // question en moyenne : le général garde sa borne.
    function tempsVoisins() {
      return {
        'Africa': 614000,
        'Asia': 490000,
        'Europe': 518000,
        'North America': 98000,
        'South America': 146000,
        'tous': 1872000
      };
    }

    // Semaine du classement de la semaine : repart le lundi à 0 h UTC
    // (src/epreuve/bareme.ts, semaine()).
    function semaineCourante() {
      return 's' + string(int(math.floor((request.time.toMillis() - 345600000) / 604800000)));
    }

    // Chrono : toutes les questions de la série (n) ; juste ou faux, les
    // points sont les justes (barème 2, 12/11/2026) ; au moins 0,2 s par
    // question, 15 s au plus. Le
    // général (n = 0) additionne les records du Chrono de tous les sujets
    // ouverts (D40 a) : 1887 questions au plus (195 pays deux fois, par
    // continent et tous, + 24 communes + 195 capitales deux fois + 195
    // drapeaux deux fois + 50 mers + 166 silhouettes deux fois + 156 voisins
    // et 155 par continent ; BORNE_GENERAL de src/epreuve/chrono.ts, 1555 tant
    // que les silhouettes sont cachées). Chaque sujet ouvert la monte, ces
    // règles d'abord.
    function chronoValide(d, n) {
      return d.questions >= 1 && (n == 0 ? d.questions <= 1887 : d.questions == n)
        && d.points == d.justes
        && d.temps_ms >= d.questions * 200 && d.temps_ms <= d.questions * 15000;
    }

    // Quiz général (étude J2 § 9.3, décision « Quiz général », barème 2 dès sa
    // naissance) : 20 questions, chacune juste ou fausse (points = justes) ;
    // au moins 0,2 s par question, au plus le délai de chacune, au total. Les
    // règles ne savent pas que les questions viennent de la bonne
    // difficulté : sans serveur, seule la vraisemblance. Jamais au général :
    // son total n'additionne que des Chrono (epreuvesDuGeneral).
    function quizValide(d, difficulte) {
      return d.questions == 20
        && d.points == d.justes
        && d.temps_ms >= 20 * 200 && d.temps_ms <= tempsQuiz()[difficulte];
    }

    // Sans faute : les justes d'affilée (points = justes), plus l'erreur qui a
    // fini la partie, sauf la série vidée ; le temps des justes seules, de 0,2
    // à `max` ms chacune : 15 s, 32 s pour les Voisins (le délai de la Chine,
    // exception du 28/11 de « Barème et classements » ;
    // TEMPS_MAX_JUSTE_VOISINS_MS de src/epreuve/chrono.ts).
    function sansFauteValide(d, n, max) {
      return d.points == d.justes
        && (d.questions == d.justes + 1 || (d.questions == d.justes && d.justes == n))
        && d.questions <= n
        && d.temps_ms >= d.justes * 200 && d.temps_ms <= d.justes * max;
    }

    // La forme du pseudo (src/epreuve/chrono.ts, formePseudo, sa copie) : des
    // mots séparés d'une espace simple, sans espace au bord, ni séparateur
    // Unicode (\p{Z}), ni caractère de contrôle, de format ou invisible
    // (\p{C} : U+200B, trait d'union conditionnel, saut de ligne). Sinon un
    // client modifié publie « Michel » + U+200B, une place à part qui
    // s'affiche comme celle de « Michel » (audit du 07/11/2026, #25). Les
    // homoglyphes (« і » cyrillique) et la forme NFD restent : sans serveur,
    // on ne les arrête pas.
    function formePseudo(pseudo) {
      return pseudo.matches('[^\\p{Z}\\p{C}]+( [^\\p{Z}\\p{C}]+)*');
    }

    function scoreValide(epreuve) {
      let d = request.resource.data;
      let p = epreuve.split(':');
      return d.keys().hasOnly(['pseudo', 'points', 'justes', 'questions', 'temps_ms', 'date', 'bareme'])
        && d.keys().hasAll(['pseudo', 'points', 'justes', 'questions', 'temps_ms', 'date', 'bareme'])
        && d.pseudo is string && d.pseudo.size() >= 2 && d.pseudo.size() <= 20
        && formePseudo(d.pseudo)
        && d.points is int && d.justes is int && d.questions is int && d.temps_ms is int
        && d.bareme == 2
        && d.date == request.time
        && d.justes >= 0 && d.justes <= d.questions
        && (epreuve == 'general'
          ? chronoValide(d, 0)
          : epreuveConnue(p)
            && (p[0] == 'quiz' ? quizValide(d, p[2])
              : p[0] == 'chrono' ? chronoValide(d, tailles(p[1])[p[2]])
                && (p[1] != 'voisins' || d.temps_ms <= tempsVoisins()[p[2]])
              : sansFauteValide(d, tailles(p[1])[p[2]], p[1] == 'voisins' ? 32000 : 15000)));
    }

    // Un record ne se réécrit que s'il progresse : plus de points (de
    // justes), puis moins de temps. Le classement ne départage pas aux
    // questions (src/epreuve/classement.ts) : moins de questions à points et
    // temps égaux, ou le même score, ne passe qu'en gardant le pseudo stocké.
    // Un autre appareil ne renomme donc la place qu'en annonçant un meilleur
    // score (07/11/2026) ; les scores étant déclarés par l'appli, sans
    // serveur, cela n'arrête que la republication honnête. Filet : une place
    // du barème 1 (~1 000 points par juste, avant le 12/11/2026) que la
    // migration de l'outil du propriétaire (scripts/admin/taches.mjs,
    // bareme) n'a pas encore réécrite (ces règles partent avant elle) se
    // compare par ses justes, ses points au barème 2
    // (src/epreuve/classement.ts, enPlace) : sinon elle ne serait jamais
    // battue.
    function progresse() {
      let n = request.resource.data;
      let a = resource.data;
      let ap = a.get('bareme', 1) == 1 ? a.justes : a.points;
      return n.points > ap
        || (n.points == ap && n.temps_ms < a.temps_ms)
        || (n.points == ap && n.temps_ms == a.temps_ms && n.questions < a.questions && n.pseudo == a.pseudo)
        || (n.points == ap && n.temps_ms == a.temps_ms && n.justes == a.justes && n.questions == a.questions
          && n.pseudo == a.pseudo);
    }

    // La place d'un pseudo : son nom en minuscules (src/epreuve/chrono.ts,
    // clePseudo, le toLowerCase de JavaScript ; clePermise y est la copie de
    // cette règle, que tests/regles.test.ts confronte à l'émulateur). Le
    // lower() des règles ne baisse que les lettres ASCII (émulateur,
    // 07/11/2026 : « Élodie ».lower() reste « Élodie », sans erreur) ; il
    // n'est appliqué ici qu'à de l'ASCII, pour ne pas dépendre de ce qu'il
    // fait d'autre en production. La clé n'a aucune majuscule ; ses
    // caractères ASCII sont ceux du pseudo baissé, à la même place
    // (caractères non ASCII masqués deux fois, par « _ » puis par « ~ » : un
    // vrai « _ » ou « ~ » de la clé ne tient pas lieu d'un caractère non
    // ASCII) ; ses caractères non ASCII sont ceux du pseudo, dans l'ordre.
    // Seule exception : si le pseudo a une majuscule non ASCII (« Élodie »,
    // « Œil », « Ñandú »), chacune de ses lettres non ASCII répond à une
    // minuscule de la clé, sans la comparer : « ölodie » passe pour
    // « Élodie », comme passent les homoglyphes, inévitables. Une place à clé
    // ASCII (« michel ») ne reçoit ainsi que ce pseudo, à la casse près ;
    // l'appli d'avant, qui nommait la place par le compte, est refusée.
    // (?s) : « . » prend aussi un saut de ligne.
    function majuscule() {
      return '(?s).*[\\p{Lu}\\p{Lt}].*';
    }
    function asciiDuPseudo(cle, pseudo) {
      return cle.replace('[^ -~]', '_') == pseudo.replace('[^ -~]', '_').lower()
        && cle.replace('[^ -~]', '~') == pseudo.replace('[^ -~]', '~').lower();
    }
    function cleDuPseudo(cle, pseudo) {
      let horsAscii = pseudo.replace('[ -~]', '');
      let autres = cle.replace('[ -~]', '');
      return !cle.matches(majuscule()) && asciiDuPseudo(cle, pseudo)
        && (horsAscii.matches(majuscule())
          ? autres.replace('\\p{Ll}', '?') == horsAscii.replace('[\\p{Lu}\\p{Lt}\\p{Ll}]', '?')
          : autres == horsAscii);
    }

    // Écrire demande un compte (anonyme suffit). Personne ne retire une place
    // depuis l'appli : elle est à tous ceux qui jouent ce pseudo.
    match /classements/{epreuve}/periodes/{periode}/scores/{cle} {
      allow read: if true;
      allow create: if request.auth != null
        && (periode == 'toujours' || periode == semaineCourante())
        && scoreValide(epreuve)
        && cleDuPseudo(cle, request.resource.data.pseudo);
      allow update: if request.auth != null
        && (periode == 'toujours' || periode == semaineCourante())
        && scoreValide(epreuve) && progresse()
        && cleDuPseudo(cle, request.resource.data.pseudo);
    }

    // Numéro des pseudos d'invité (décision « Pseudo d'invité » du
    // 20/11/2026) : Guest-1000, puis Guest-1001… Un seul document, `n` le
    // dernier numéro donné, que l'appli prend dans une transaction au premier
    // score publié d'un invité (src/epreuve/classement.ts, numeroInvite).
    // Un compte (anonyme suffit, comme pour un score) le lit et l'avance d'un
    // seul pas ; personne ne le recule ni ne le retire.
    match /compteurs/invites {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n == 1000;
      allow update: if request.auth != null
        && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n == resource.data.n + 1;
    }

    // --- Comptes du J1b (étude § 6) ---------------------------------------

    // Un compte, pas un invité (D16) : ce que le compte possède (ses
    // identités), pas la méthode de la session (sign_in_provider, non prouvé
    // après un lien : S16). Un anonyme n'a aucune identité.
    function compte() {
      return request.auth != null
        && request.auth.token.firebase.identities.keys().hasAny(['email', 'google.com']);
    }

    // Lots 2 à 5 : `return false;`. Lots 6 et 7 (10/11) : les seules
    // adresses vérifiées de l'utilisateur. Ouverture (11/11) : `return true;`,
    // tout compte (compte() : identities) écrit chez lui, jamais un invité.
    // Urgence : `return false;` ferme tout joueurs/ (npx firebase deploy
    // --only firestore). tests/regles.test.ts remplace ce corps au chargement
    // (vrai, ou une liste d'essai de test) et vérifie celui du dépôt.
    function essai() {
      return true;
    }

    function moi(uid) {
      return compte() && request.auth.uid == uid && essai();
    }

    // Le profil (§ 5.4, src/sync/profil.ts) : pseudo et records (une chaîne
    // JSON, bornée : les règles ne savent pas borner une carte ; 131 072
    // caractères depuis le 28/11/2026, S608 du J4), l'heure du serveur. `supprime: true`, sans pseudo ni records : la pierre tombale
    // d'une suppression (§ 7.1).
    function profilValide() {
      let d = request.resource.data;
      return d.keys().hasOnly(['v', 'pseudo', 'records', 'maj', 'supprime'])
        && d.keys().hasAll(['v', 'maj'])
        && d.v == 1
        && d.maj == request.time
        && (!('pseudo' in d) || (d.pseudo is string && d.pseudo.size() >= 2 && d.pseudo.size() <= 20))
        && (!('records' in d) || (d.records is string && d.records.size() <= 131072))
        && (!('supprime' in d) || (d.supprime == true && !('pseudo' in d) && !('records' in d)));
    }

    // Pierre tombale (§ 7.1) : plus aucun lot nouveau, de cet appareil comme
    // des autres du compte. Une lecture de plus par création de lot.
    function tombe(uid) {
      let p = /databases/$(database)/documents/joueurs/$(uid);
      return exists(p) && get(p).data.get('supprime', false) == true;
    }

    // Un lot de la synchro (§ 5.2, src/sync/lots.ts, problemeLot en est la
    // copie, que tests/regles.test.ts confronte) : son id est celui de son
    // premier événement (un uuid), l'appareil et la séance aussi ; 1 à 200
    // événements encodés par position dans une chaîne, bornée à 160
    // caractères par événement (les règles ne savent pas borner une carte
    // d'une liste : D34) ; l'heure du serveur. Que la première carte porte
    // l'id du lot, seul le client le vérifie (la carte est dans la chaîne).
    // v : 1, ou 2 pour un lot qui porte `estime` (étude du J4, lot 0, D617 a) ;
    // le profil garde sa v1.
    function lotValide(lot) {
      let d = request.resource.data;
      return lot.size() == 36
        && d.keys().hasOnly(['v', 'appareil', 'seance', 'fin', 'n', 'evenements'])
        && d.keys().hasAll(['v', 'appareil', 'seance', 'fin', 'n', 'evenements'])
        && d.v in [1, 2]
        && d.appareil is string && d.appareil.size() == 36
        && (d.seance == null || (d.seance is string && d.seance.size() == 36))
        && d.fin == request.time
        && d.n is int && d.n >= 1 && d.n <= 200
        && d.evenements is string && d.evenements.size() <= d.n * 160;
    }

    match /joueurs/{uid} {
      allow read: if moi(uid);
      allow create: if moi(uid) && profilValide();
      // Une pierre tombale ne se défait pas : plus aucune écriture du profil,
      // de cet appareil comme des autres du compte.
      allow update: if moi(uid) && profilValide()
        && resource.data.get('supprime', false) != true;
      // Pas de delete par le client : la pierre tombale reste (§ 7.1).

      // Les lots du compte : en création seule (un renvoi d'un lot déjà là
      // est refusé, et l'appli le relit), lus et supprimés (§ 7.1) par le
      // compte seul.
      match /lots/{lot} {
        allow read, delete: if moi(uid);
        allow create: if moi(uid) && lotValide(lot) && !tombe(uid);
      }
    }

    // Demande de retrait des places du pseudo (D27 b, § 7.1) : écrite par le
    // compte lui-même quand il se supprime, dans le même lot d'écriture que
    // sa pierre tombale (getAfter la voit), puis traitée par l'outil du
    // propriétaire (SDK Admin, hors des règles). Création seule, bornée : le
    // pseudo (2 à 20 caractères, comme scoreValide) et l'heure du serveur.
    // Le pseudo est celui du profil du compte avant le lot (get : l'état
    // d'avant la pierre tombale, qui l'efface) : un compte ne demande pas le
    // retrait d'un pseudo que son profil ne porte pas. Sans pseudo au profil,
    // pas de demande (l'appli l'omet). Le pseudo n'étant pas réservé (« Une
    // place par pseudo »), l'outil ne retire rien sans le montrer d'abord
    // (§ 7.5). Ni lecture, ni mise à jour, ni suppression par le client.
    function demandeValide(uid) {
      let d = request.resource.data;
      let profil = /databases/$(database)/documents/joueurs/$(uid);
      return d.keys().hasOnly(['pseudo', 'cree'])
        && d.keys().hasAll(['pseudo', 'cree'])
        && d.pseudo is string && d.pseudo.size() >= 2 && d.pseudo.size() <= 20
        && d.cree == request.time
        && exists(profil) && get(profil).data.get('pseudo', null) == d.pseudo
        && getAfter(profil).data.get('supprime', false) == true;
    }

    match /demandes/{uid} {
      allow create: if moi(uid) && demandeValide(uid);
    }
  }
}
